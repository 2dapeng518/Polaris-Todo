{
  "name": "polaris-todo",
  "productName": "Polaris",
  "version": "0.8.2",
  "description": "Polaris — a premium local-first to-do app for Windows 11",
  "main": "./out/main/index.js",
  "license": "MIT",
  "private": true,
  "allowScripts": [
    "electron",
    "app-builder-bin",
    "electron-builder",
    "better-sqlite3",
    "esbuild",
    "@tailwindcss/oxide"
  ],
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "make:icon": "node scripts/make-app-icon.mjs",
    "smoke": "node scripts/smoke.mjs",
    "verify:themes": "node scripts/verify-theme-contrast.mjs && node scripts/verify-theme-registry.mjs",
    "verify:datetime": "node scripts/verify-datetime.mjs",
    "build:win": "npm run build && electron-builder --win nsis",
    "build:mac": "npm run build && electron-builder --mac"
  },
  "dependencies": {
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/noto-sans-sc": "^5.3.1",
    "better-sqlite3": "13.0.3",
    "date-fns": "4.4.0",
    "lucide-react": "1.72.0",
    "motion": "14.12.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rrule": "^2.8.1",
    "zod": "4.6.7",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.5",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "electron": "45.3.0",
    "electron-builder": "26.18.1",
    "electron-vite": "6.0.0",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  }
}
